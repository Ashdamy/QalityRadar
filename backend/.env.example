DATABASE_URL=postgresql+psycopg://qalitiradar:qalitiradar_dev@postgres:5432/qalitiradar
REDIS_URL=redis://redis:6379/0
# Minimo 32 caracteres y nunca este valor: la aplicacion no arranca con el.
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# Generala con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-with-fernet-generate-key
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
CORS_ORIGINS=http://localhost:3000
HUGGINGFACE_API_KEY=

# En produccion, false: apaga /docs, /redoc y /openapi.json.
ENABLE_API_DOCS=true

# En produccion, true: la cookie de sesion solo viaja por HTTPS. En local
# tiene que ser false, o el navegador descarta una cookie Secure sobre HTTP y
# no hay forma de iniciar sesion.
COOKIE_SECURE=false

# Direccion publica de la aplicacion. Se usa para construir la URL de la
# insignia que el usuario pega en su README: si apunta a localhost, la imagen
# no carga en ningun sitio salvo en la maquina de quien la genero.
PUBLIC_BASE_URL=http://localhost:8000

# Direccion del frontend: el enlace de verificacion del correo apunta aqui.
FRONTEND_BASE_URL=http://localhost:3000

# Correo de verificacion. En local, el Mailpit del docker-compose (bandeja en
# http://localhost:8025). En produccion, un proveedor real con STARTTLS=true:
# sin SMTP_HOST no sale ningun correo y nadie puede registrarse con contrasena.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=QalitiRadar <no-reply@localhost>

# Medicion en navegador real (Lighthouse + axe-core) de los analisis de URL.
# Antes de activarla: docker build -f navegador/Dockerfile -t qaliti/navegador:latest .
# y, en el servidor Linux, sudo sh navegador/red.sh. Ver docs/SECURITY.md.
NAVEGADOR_REAL=false
